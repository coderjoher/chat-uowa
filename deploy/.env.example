# Copy to .env and adjust.

# Public address of the chat; its DNS A record must point at this server.
DOMAIN=chat.uowa.edu.iq

# Email that Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=it-admin@uowa.edu.iq

# Rocket.Chat release; check https://github.com/RocketChat/Rocket.Chat/releases before upgrading.
RELEASE=8.9.0

MONGO_VERSION=8.0

# Default language for new users: en or ar.
LANGUAGE=en

# Local testing only (docker-compose.local.yml): the address other devices use to reach this computer.
# LOCAL_URL=http://192.168.1.20:3000
